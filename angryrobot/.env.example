# AngryRobot v2 — variables de entorno. Este archivo NO se sube con valores (.gitignore).
# En Render: Environment. Pega tú los valores; no los compartas en chats ni commits.

# Protege todos los endpoints (Authorization: Bearer <secreto> o X-AngryRobot-Secret).
ANGRYROBOT_SHARED_SECRET=

# Inferencia del agente upstream (proxy) y del juez. Con OpenRouter gana OpenRouter (auto).
OPENROUTER_API_KEY=
# HF_TOKEN=                      # alternativa: Hugging Face Inference Providers

# Modelos (opcionales). El juez debe ser de otra familia que el agente (/health lo comprueba).
# ANGRYROBOT_AGENT_MODEL=openai/gpt-oss-120b
# ANGRYROBOT_JUDGE_MODEL=meta-llama/llama-3.3-70b-instruct
# ANGRYROBOT_JUDGE_PROVIDER=auto        # auto | openrouter | hf | anthropic | mock
# ANGRYROBOT_UPSTREAM_PROVIDER=auto     # auto | openrouter | hf

# Clave de la org de HappyRobot: la usa providers.py (conectar agentes existentes, crear la credencial Custom LLM)
# y las herramientas tools/hr_*.py (que la leen como HR_API_KEY). Org EU: HR_BASE=https://platform.eu.happyrobot.ai/api/v2
HAPPYROBOT_API_KEY=
HR_API_KEY=
HR_BASE=https://platform.eu.happyrobot.ai/api/v2
