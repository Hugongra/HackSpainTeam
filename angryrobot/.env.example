# AngryRobot — variables de entorno.
# Este archivo NO se sube a git (.gitignore). En Render: Environment -> "Add from .env".
# Pega tú mismo los valores; no los compartas en chats ni commits.

# Juez independiente (auditor.py). Empieza por sk-or-
OPENROUTER_API_KEY=

# Opcional: modelo del juez (por defecto meta-llama/llama-3.1-8b-instruct)
# ANGRYROBOT_AUDITOR_MODEL=

# Protege /audit y /feedback (header X-AngryRobot-Secret). HappyRobot debe mandar este mismo valor.
ANGRYROBOT_SHARED_SECRET=

# Solo la usa integrations/happyrobot_client.py (no el motor de auditoría). Empieza por sk_live_
HAPPYROBOT_API_KEY=
